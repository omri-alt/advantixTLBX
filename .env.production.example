# KLblend production .env — copy to .env on the server and fill secrets.
# Do not commit .env. See docker-compose.yml (runtime/ + data/ volumes) and secrets/credentials.json.

# --- AutoServer scheduler (hourly automations on /automations) ---
AUTOSERVER_SCHEDULER_ENABLED=1
# Hour gates for even/odd jobs (QualityWL, KLWL, BlendSync2h, KeitaroFeedBalanceCheckmon).
AUTOSERVER_SCHEDULER_TZ=Europe/Jerusalem
# Optional: run all hourly jobs once after deploy (off by default; can overload worker).
# AUTOSERVER_STARTUP_CATCHUP=0

# --- SourceKnowledge (QualityWL, KLWL, SKExplorationOptimizer, optimizers) ---
KEYSK=
# Legacy alias also accepted: keySK=

# --- Zeropark (Mehilot, CloseNipuhim, CloseBlendZp) ---
KEYZP=
# Nightly pause generalMehila-* (CloseNipuhimAuto)
# ZEROPARK_CLOSE_TZ=Europe/Warsaw
# ZEROPARK_CLOSE_HOUR=23
# ZEROPARK_CLOSE_MINUTE=30
# Nightly pause mapped Blend campaigns on ZP BLEND campaignsID (CloseBlendZpAuto; defaults to above)
# ZEROPARK_BLEND_CAP_SPREADSHEET_ID=   # defaults to BLEND_SHEETS_SPREADSHEET_ID
# ZEROPARK_BLEND_CAP_SHEET_NAME=ZP BLEND campaignsID
# ZEROPARK_BLEND_NIGHTLY_CLOSE_ENABLED=1

# --- Ecomnia (EcomniaTrackAuto hourly sheets) — KLblend names or legacy AutoServer names ---
ADVERTISER_KEY=
AUTH_KEY=
SECRET_KEY=
# Legacy: ECadvKey, ECauthKey, ECsecretKey (set via ensure_autoserver_env if above are set)

# --- Kelkoo / daily workflow ---
# FEED1_API_KEY= ...
# FEED2_API_KEY= ...
# FEED5_API_KEY= ...
# Daily workflow v2 cron (APScheduler when Control Center runs)
# DAILY_WORKFLOW_SCHEDULER_ENABLED=1
# DAILY_WORKFLOW_SCHEDULER_HOUR_LOCAL=9
# DAILY_WORKFLOW_SCHEDULER_MINUTE=0
# DAILY_WORKFLOW_SCHEDULER_TZ=Asia/Jerusalem
# Kelkoo daily postbacks first try (default 08:00 Asia/Jerusalem)
# KELKOO_DAILY_POSTBACK_SCHEDULER_HOUR_LOCAL=8
# KELKOO_DAILY_POSTBACK_SCHEDULER_TZ=Asia/Jerusalem
# 4th Kelkoo publisher (tagkelkoo4 / checkmon feed8); postbacks fire at 70% net by default
# FEED4_API_KEY= ...
# Offer URLs: visit-sites.com/klk-merchant2 (Keitaro template "KL feed 4")
# FEED4_POSTBACK_REVENUE_SHARE=0.7
# KEITARO_BASE_URL=
# KEITARO_API_KEY=

# --- Blend + Keitaro automations ---
# BLEND_SHEETS_SPREADSHEET_ID=
TRILLION_BLEND_CAP_GUARD_ENABLED=1
KEITARO_FEED_BALANCE_CHECKMON_ENABLED=yes
# Hub 94 active feeds (adexa included for NIPUHIM-adexa soft launch)
# KEITARO_HUB_ACTIVE_FEEDS=kelkoo1,kelkoo2,kelkoo5,kelkoo4,adexa
# Nipuhim domain-demand clicks per merchant×geo (Adexa soft-launch lower cap)
# DOMAIN_DEMAND_NIPUHIM_CLICKS_PER_GEO=500
# DOMAIN_DEMAND_NIPUHIM_ADEXA_CLICKS_PER_GEO=300
# Daily 1 Adexa merchant/geo → NIPUHIM-adexa (smartlink preferred, else static links).
# Once used, merchant is blocked for the rest of the calendar month via {month}_log_adexa.
# ADEXA_NIPUHIM_ENABLED=1
# ADEXA_NIPUHIM_GEOS=fr,uk,de,it,es,nl,dk,no,se,be,at

# --- Google Sheets (service account file mounted at /app/credentials.json in Docker) ---
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json
SK_TOOLS_SPREADSHEET_ID=
# SK_OPTIMIZER_SHEET_ID=  # defaults to SK_TOOLS_SPREADSHEET_ID
# Daily Keitaro sales → SKtrackExploration.wl + QualityWL (12:00 Israel by default).
SK_EXPLORATION_WL_SYNC_ENABLED=1
SK_EXPLORATION_WL_SYNC_TZ=Asia/Jerusalem
SK_EXPLORATION_WL_SYNC_HOUR_LOCAL=12
SK_EXPLORATION_WL_SYNC_MINUTE=0

# Trillion nightly hub close (campaign 94 alias in Target_URL). Default 01:00 Israel.
TRILLION_HUB_NIGHTLY_CLOSE_ENABLED=1
TRILLION_HUB_CLOSE_TZ=Asia/Jerusalem
TRILLION_HUB_CLOSE_HOUR=1
TRILLION_HUB_CLOSE_MINUTE=0
# TRILLION_HUB_CLOSE_ALIAS=yPBBvXxR
# TRILLION_HUB_CLOSE_FOLDERS=Blend

# --- Flask ---
# FLASK_SECRET_KEY=

# Homepage overview tiles (revenue + DSP costs). Rebuild twice daily Israel time.
OVERVIEW_SCHEDULER_ENABLED=1
OVERVIEW_SNAPSHOT_TZ=Asia/Jerusalem
OVERVIEW_SNAPSHOT_HOURS=11,16
# On multi-worker Gunicorn: set OVERVIEW_SCHEDULER_ENABLED=0 on all but one worker.
